@using app_asistencia_saferisk.Helper

@{
    ViewData["Title"] = "Inicio";
    var nombres = UsuarioSesionHelper.Nombres(Context) ?? "Usuario";
}

@section Styles {
    <link href="~/css/Jornada.css" rel="stylesheet" />
}

<div class="container-xxl py-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8 text-center">
            <h2 class="fw-semibold mb-1">
                <i class="mdi mdi-account-badge-outline text-primary me-2"></i>
                ¡Bienvenido, @nombres!
            </h2>
            <p class="lead text-muted mb-2">Este es tu panel principal de asistencia.</p>
            <p class="text-muted mb-0">
                <i class="mdi mdi-calendar-today text-primary me-1"></i>
                Hoy: @DateTime.Now.ToString("dddd, dd 'de' MMMM yyyy")
            </p>
        </div>
    </div>

    <!-- Toast Container fijo -->
    <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>

    <div class="row justify-content-center g-4 mt-1">
        <!-- Card Jornada -->
        <div class="col-xl-5 col-lg-6">
            <div class="card card-animate shadow rounded-4 h-100">
                <div class="card-body py-4 text-center">
                    <i class="mdi mdi-calendar-check text-success fs-1"></i>
                    <h4 class="fw-bold my-3">Mi Jornada de Hoy</h4>

                    <div class="mb-3">
                        <span class="badge bg-info-subtle text-info fs-6 px-3 py-2">
                            <i class="mdi mdi-timer-outline me-1"></i>
                            Estado:
                            <span id="estadoJornada" aria-live="polite">Cargando...</span>
                        </span>
                    </div>

                    <!-- Registrar llegada / horas extra -->
                    <div id="formLlegadaContainer">
                        <div class="d-flex flex-column align-items-center">
                            <form id="formRegistrarLlegada" class="w-100">
                                <fieldset class="mb-4">
                                    <legend class="visually-hidden">Tipo de jornada</legend>
                                    <div id="jornadaRadios" class="d-flex justify-content-center gap-4">
                                        <div class="form-check form-check-inline fs-5">
                                            <input class="form-check-input" type="radio" name="tipoJornada"
                                                   id="jornadaOficina" value="oficina" checked>
                                            <label class="form-check-label" for="jornadaOficina">
                                                <i class="mdi mdi-office-building-marker-outline me-1"></i> Oficina
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline fs-5">
                                            <input class="form-check-input" type="radio" name="tipoJornada"
                                                   id="jornadaRemoto" value="remoto">
                                            <label class="form-check-label" for="jornadaRemoto">
                                                <i class="mdi mdi-home-city-outline me-1"></i> Remoto
                                            </label>
                                        </div>
                                    </div>
                                </fieldset>

                                <div class="form-check form-switch mb-3 text-start">
                                    <input class="form-check-input" type="checkbox" id="switchModoJornada">
                                    <label class="form-check-label" for="switchModoJornada">
                                        Modo Horas Extra
                                    </label>
                                </div>

                                <!-- Botón Llegada -->
                                <button type="submit"
                                        class="btn btn-success btn-lg w-100 mb-2 d-flex justify-content-center align-items-center"
                                        id="btnRegistrarLlegada">
                                    <span id="btnLlegadaText">
                                        <i class="mdi mdi-login-variant me-1"></i> Registrar Llegada
                                    </span>
                                    <span id="spinnerLlegada"
                                          class="spinner-border spinner-border-sm ms-2 d-none"
                                          role="status" aria-hidden="true"></span>
                                </button>

                                <!-- Botón Horas Extra -->
                                <button type="button"
                                        class="btn btn-warning btn-lg w-100 d-flex justify-content-center align-items-center d-none"
                                        id="btnRegistrarHorasExtra">
                                    <span id="btnHorasExtraText">
                                        <i class="mdi mdi-timer-plus me-1"></i> Registrar Horas Extra
                                    </span>
                                    <span id="spinnerHorasExtra"
                                          class="spinner-border spinner-border-sm ms-2 d-none"
                                          role="status" aria-hidden="true"></span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Acciones jornada -->
                    <div id="accionesJornada" class="my-4 d-none">
                        <div class="d-flex flex-wrap gap-3 justify-content-center">
                            <!-- Almuerzo -->
                            <button class="btn btn-warning btn-lg d-flex align-items-center"
                                    id="btnAlmuerzo">
                                <span id="btnAlmuerzoText">
                                    <i class="mdi mdi-silverware-fork-knife me-1"></i> Almuerzo
                                </span>
                                <span id="spinnerAlmuerzo"
                                      class="spinner-border spinner-border-sm ms-2 d-none"
                                      role="status" aria-hidden="true"></span>
                            </button>

                            <!-- Break -->
                            <button class="btn btn-info btn-lg d-flex align-items-center"
                                    id="btnBreak">
                                <span id="btnBreakText">
                                    <i class="mdi mdi-coffee me-1"></i> Break
                                </span>
                                <span id="spinnerBreak"
                                      class="spinner-border spinner-border-sm ms-2 d-none"
                                      role="status" aria-hidden="true"></span>
                            </button>

                            <!-- Salida -->
                            <button class="btn btn-danger btn-lg d-flex align-items-center"
                                    id="btnSalida">
                                <span id="btnSalidaText">
                                    <i class="mdi mdi-logout-variant me-1"></i> Salida
                                </span>
                                <span id="spinnerSalida"
                                      class="spinner-border spinner-border-sm ms-2 d-none"
                                      role="status" aria-hidden="true"></span>
                            </button>

                            <!-- Acciones Extra -->
                            <button class="btn btn-secondary btn-lg d-flex align-items-center"
                                    id="btnExtras" data-bs-toggle="offcanvas"
                                    data-bs-target="#offcanvasExtras" type="button">
                                <i class="mdi mdi-dots-horizontal me-1"></i> Acciones Extra
                            </button>

                            <!-- NUEVO: Solicitar ajuste -->
                            <button class="btn btn-outline-primary btn-lg" id="btnSolicitarAjuste" type="button">
                                <i class="mdi mdi-clipboard-text-clock-outline me-1"></i> Solicitar ajuste
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Card Timeline -->
        <div class="col-xl-5 col-lg-6">
            <div class="card shadow rounded-4 h-100">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-semibold mb-0">
                            <i class="mdi mdi-timeline-clock-outline text-warning me-2"></i>
                            Mi Timeline del Día
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRefrescarTimeline">
                            <i class="mdi mdi-refresh me-1"></i> Actualizar
                        </button>
                    </div>
                    <div id="timelineEventos">
                        <div class="text-center py-4 text-muted">
                            <i class="mdi mdi-progress-clock mdi-36px mb-2"></i>
                            <br />
                            Cargando eventos de hoy...
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Offcanvas Lateral para Acciones Extra -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasExtras" aria-labelledby="offcanvasExtrasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasExtrasLabel">
            <i class="mdi mdi-dots-horizontal-circle-outline me-1"></i> Acciones Extra
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <div id="accionesExtraBtns" class="d-grid gap-2"></div>

        <div id="campoObservacion" class="mt-3 d-none">
            <label for="extraObservaciones" class="form-label">
                Observaciones
                <span class="text-muted small">(opcional)</span>
            </label>
            <input type="text" id="extraObservaciones" class="form-control" maxlength="255" />
        </div>

        <button class="btn btn-primary mt-3 w-100 d-flex align-items-center justify-content-center"
                id="btnRegistrarExtra" disabled>
            <span id="btnRegistrarExtraText">Registrar acción</span>
            <span id="spinnerRegistrarExtra"
                  class="spinner-border spinner-border-sm ms-2 d-none"
                  role="status" aria-hidden="true"></span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        window.appRoutes = {
            registrarLlegadaHorasExtra: '@Url.Action("RegistrarLlegadaHorasExtra", "HorasExtra")',
            registrarLlegada: '@Url.Action("RegistrarLlegada", "Jornada")',
            cerrarJornada: '@Url.Action("CerrarJornada", "Jornada")',
            registrarHorasExtra: '@Url.Action("Registrar", "HorasExtra")',
            estadoActual: '@Url.Action("EstadoActual", "Jornada")',
            timelineHoy: '@Url.Action("TimelineHoy", "Jornada")',
            registrarEvento: '@Url.Action("RegistrarEvento", "Jornada")',
            crearSolicitudAjuste: '@Url.Action("Crear", "SolicitudesAjuste")'
        };
    </script>

    <script src="~/js/funciones.js" type="text/javascript"></script>
}
